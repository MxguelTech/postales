---
import { Client } from '@notionhq/client';
import fs from 'node:fs';
import path from 'node:path';

const notion = new Client({ auth: import.meta.env.NOTION_TOKEN });

const response = await notion.databases.query({
  database_id: import.meta.env.NOTION_DATABASE_ID,
  sorts: [
    {
      property: 'Dia',
      direction: 'ascending',
    },
  ],
});

const dias = response.results.map((page) => ({
  nombre: page.properties.Nombre.rich_text[0]?.plain_text ?? '',
  viaje: page.properties.Viaje.rich_text[0]?.plain_text ?? '',
  dia: page.properties.Dia.number,
  texto: page.properties.Texto.rich_text[0]?.plain_text ?? '',
  slug: page.properties.Slug.url ?? '',
}));

const EXTENSIONES_VALIDAS = ['.jpg', '.jpeg', '.png', '.webp'];

function listarFotos(viaje, numDia) {
  const carpeta = path.join(process.cwd(), 'public', 'fotos', 'tenerife', `dia${numDia}`);
  if (!fs.existsSync(carpeta)) return [];
  return fs
    .readdirSync(carpeta)
    .filter((archivo) => EXTENSIONES_VALIDAS.includes(path.extname(archivo).toLowerCase()))
    .sort()
    .map((archivo) => `/fotos/tenerife/dia${numDia}/${archivo}`);
}

const diasConFotos = dias.map((d) => ({
  ...d,
  fotos: listarFotos(d.viaje, d.dia),
}));

const nombreViaje = diasConFotos[0]?.viaje ?? '';
---
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{nombreViaje}</title>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: -apple-system, sans-serif;
      max-width: 480px;
      margin: 0 auto;
      padding: 24px 16px;
      background: #fafafa;
      user-select: none;
    }
    h1 { font-size: 22px; margin: 0 0 4px; }
    .subtitulo { font-size: 13px; color: #777; margin: 0 0 24px; }
    .timeline {
      display: flex;
      align-items: center;
      margin-bottom: 24px;
    }
    .punto-wrap {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      background: none;
      border: none;
      font-family: inherit;
    }
    .punto {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      border: 2px solid #999;
      background: white;
      transition: background 0.2s, border-color 0.2s;
    }
    .punto-wrap.activo .punto {
      background: #2563eb;
      border-color: #2563eb;
    }
    .etiqueta { font-size: 11px; color: #777; }
    .punto-wrap.activo .etiqueta { color: #2563eb; font-weight: 600; }
    .linea { flex: 1; height: 1.5px; background: #ccc; margin-bottom: 20px; }
    .panel-contenedor {
      overflow: hidden;
      touch-action: pan-y;
    }
    .panel {
      background: white;
      border-radius: 12px;
      border: 1px solid #eee;
      padding: 16px;
    }
    .panel h2 { font-size: 16px; margin: 0 0 6px; }
    .panel p { font-size: 13px; color: #555; line-height: 1.6; margin: 0 0 12px; }
    .sin-fotos { font-size: 12px; color: #aaa; }
    .fotos {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
    }
    .fotos img {
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
      border-radius: 8px;
      background: #eee;
    }
  </style>
</head>
<body>
  <h1>{nombreViaje}</h1>
  <p class="subtitulo">{diasConFotos.length} dias explorando la zona</p>

  <div class="timeline">
    {diasConFotos.map((d, i) => (
      <>
        <button class="punto-wrap" class:list={[{ activo: i === 0 }]} data-index={i}>
          <span class="punto"></span>
          <span class="etiqueta">Dia {d.dia}</span>
        </button>
        {i < diasConFotos.length - 1 && <div class="linea"></div>}
      </>
    ))}
  </div>

  <div class="panel-contenedor" id="panel-contenedor">
    {diasConFotos.map((d, i) => (
      <div class="panel" data-index={i} style={i === 0 ? '' : 'display:none'}>
        <h2>{d.nombre}</h2>
        <p>{d.texto}</p>
        {d.fotos.length > 0 ? (
          <div class="fotos">
            {d.fotos.map((f) => <img src={f} loading="lazy" />)}
          </div>
        ) : (
          <p class="sin-fotos">Sin fotos todavia</p>
        )}
      </div>
    ))}
  </div>

  <script>
    const botones = Array.from(document.querySelectorAll('.punto-wrap'));
    const paneles = Array.from(document.querySelectorAll('.panel'));
    const contenedor = document.getElementById('panel-contenedor');
    let indiceActual = 0;

    function mostrarDia(indice) {
      if (indice < 0 || indice >= paneles.length) return;
      indiceActual = indice;

      botones.forEach((b, i) => b.classList.toggle('activo', i === indice));
      paneles.forEach((p, i) => {
        p.style.display = i === indice ? '' : 'none';
      });
    }

    botones.forEach((boton) => {
      boton.addEventListener('click', () => {
        mostrarDia(Number(boton.dataset.index));
      });
    });

    let xInicio = 0;
    let yInicio = 0;

    contenedor.addEventListener('touchstart', (e) => {
      xInicio = e.touches[0].clientX;
      yInicio = e.touches[0].clientY;
    }, { passive: true });

    contenedor.addEventListener('touchend', (e) => {
      const xFin = e.changedTouches[0].clientX;
      const yFin = e.changedTouches[0].clientY;
      const deltaX = xFin - xInicio;
      const deltaY = yFin - yInicio;

      if (Math.abs(deltaX) < 50 || Math.abs(deltaX) < Math.abs(deltaY)) return;

      if (deltaX < 0) {
        mostrarDia(indiceActual + 1);
      } else {
        mostrarDia(indiceActual - 1);
      }
    });
  </script>
</body>
</html>